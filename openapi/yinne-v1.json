          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "operationId": "ingestMockProviderWebhook",
        "security": [],
        "description": "Test-only raw-body ingress. Requires Yinne-Mock-Timestamp and Yinne-Mock-Signature; enforces a five-minute replay window and provider-event deduplication.",
        "responses": {
          "200": { "description": "Durably accepted; duplicate events are acknowledged" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Yinne API key" }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "After": { "name": "after", "in": "query", "schema": { "type": "string" } },
      "Search": {
        "name": "search",
        "in": "query",
        "schema": { "type": "string", "maxLength": 120 }
      },
      "CustomerId": {
        "name": "customer_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "VariantId": {
        "name": "variant_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "OrderId": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "PaymentId": {
        "name": "payment_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "RefundId": {
        "name": "refund_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "TransactionId": {
        "name": "transaction_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 255 }
      }
    },
    "schemas": {
      "Money": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "description": "Integer minor units; never a floating-point value."
      },
      "ProductStatus": { "type": "string", "enum": ["draft", "active", "archived"] },
      "FinancialStatus": {
        "type": "string",
        "enum": ["unpaid", "paid", "partially_refunded", "refunded"]
      },
      "FulfilmentStatus": { "type": "string", "enum": ["unfulfilled", "fulfilled", "cancelled"] },
      "CustomerInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 160 },
          "email": { "type": ["string", "null"], "format": "email" },
          "phone": { "type": ["string", "null"], "maxLength": 40 },
          "external_ref": { "type": ["string", "null"], "maxLength": 160 },
          "metadata": { "type": "object" }
        }
      },
      "Customer": {
        "allOf": [
          { "$ref": "#/components/schemas/CustomerInput" },
          {
            "type": "object",
            "required": ["id", "version", "pii_redacted", "created_at", "updated_at"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "version": { "type": "integer" },
              "pii_redacted": { "type": "boolean" },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "VariantInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "title", "unit_amount", "currency"],
        "properties": {
          "sku": { "type": "string", "maxLength": 100 },
          "title": { "type": "string", "maxLength": 160 },
          "unit_amount": { "$ref": "#/components/schemas/Money" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "track_inventory": { "type": "boolean", "default": true }
        }
      },
      "ProductInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "maxLength": 160 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": { "type": ["string", "null"], "maxLength": 10000 },
          "metadata": { "type": "object" },
          "variants": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/VariantInput" }
          }
        }
      },
      "InventoryAdjustmentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "location_id", "delta", "reason"],
        "properties": {
          "variant_id": { "type": "string", "format": "uuid" },
          "location_id": { "type": "string", "format": "uuid" },
          "delta": { "type": "string", "pattern": "^-?[1-9][0-9]*$" },
          "reason": { "type": "string", "minLength": 2, "maxLength": 240 }
        }
      },
      "OrderInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["merchant_id", "location_id", "currency", "items"],
        "properties": {
          "merchant_id": { "type": "string", "format": "uuid" },
          "location_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": ["string", "null"], "format": "uuid" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant_id", "quantity"],
              "properties": {
                "variant_id": { "type": "string", "format": "uuid" },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 }
              }
            }
          },
          "metadata": { "type": "object" }
        }
      },
      "PaymentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_id"],
        "properties": {
          "order_id": { "type": "string", "format": "uuid" },
          "provider_account_id": { "type": "string", "format": "uuid" },
          "confirmation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mock_scenario": {
                "type": "string",
                "enum": [
                  "success",
                  "failure:declined",
                  "pending:then_success",
                  "pending:then_failure",
                  "timeout:then_success"
                ]
              }
            }
          },
          "metadata": { "type": "object" }
        }
      },
      "RefundInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id", "reason"],
        "properties": {
          "payment_id": { "type": "string", "format": "uuid" },
          "amount": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
          "reason": { "type": "string", "minLength": 2, "maxLength": 240 },
          "confirmation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mock_scenario": { "type": "string", "enum": ["refund_success", "refund_failure"] }
            }
          },
          "metadata": { "type": "object" }
        }
      },
      "CheckoutSessionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["merchant_id", "location_id", "currency", "items"],
        "properties": {
          "merchant_id": { "type": "string", "format": "uuid" },
          "location_id": { "type": "string", "format": "uuid" },
          "customer_id": { "type": ["string", "null"], "format": "uuid" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["variant_id", "quantity"],
              "properties": {
                "variant_id": { "type": "string", "format": "uuid" },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 }
              }
            }
          },
          "success_url": { "type": "string", "format": "uri" },
          "cancel_url": { "type": "string", "format": "uri" },
          "expires_in_seconds": { "type": "integer", "minimum": 300, "maximum": 86400 },
          "metadata": { "type": "object" }
        }
      },
      "PaymentLinkInput": {
        "type": "object",
        "description": "Discriminated product, fixed, or flexible link. Amounts are positive integer minor-unit strings.",
        "required": ["kind", "merchant_id", "location_id", "name", "currency"],
        "properties": {
          "kind": { "type": "string", "enum": ["product", "fixed", "flexible"] },
          "merchant_id": { "type": "string", "format": "uuid" },
          "location_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 160 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "variant_id": { "type": "string", "format": "uuid" },
          "quantity": { "type": "integer", "minimum": 1 },
          "amount": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
          "minimum_amount": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
          "maximum_amount": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{0,18}$" },
          "usage_limit": { "type": ["integer", "null"], "minimum": 1 },
          "metadata": { "type": "object" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["type", "code", "message", "param", "request_id", "details"],
            "properties": {
              "type": { "type": "string" },
              "code": { "type": "string" },
              "message": { "type": "string" },
              "param": { "type": ["string", "null"] },
              "request_id": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "requestBodies": {
      "Customer": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/CustomerInput" } }
        }
      },
      "Variant": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/VariantInput" } }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Canonical API error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "CustomerPage": {
        "description": "Cursor-paginated customers",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["data", "has_more", "next_cursor", "request_id"],
              "properties": {
                "data": { "type": "array", "items": { "$ref": "#/components/schemas/Customer" } },
                "has_more": { "type": "boolean" },
                "next_cursor": { "type": ["string", "null"] },
                "request_id": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
