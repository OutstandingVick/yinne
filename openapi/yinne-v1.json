{
  "openapi": "3.1.0",
  "info": {
    "title": "Yinne API",
    "version": "2026-08-28",
    "description": "Phase 4 Checkout and Payment Links over the canonical Commerce and Payments cores. Money uses integer minor-unit strings; only the deterministic test-mode Mock Provider is implemented."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/customers": {
      "get": {
        "operationId": "listCustomers",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" },
          { "$ref": "#/components/parameters/Search" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CustomerPage" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createCustomer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CustomerInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["customer", "request_id"],
                  "properties": {
                    "customer": { "$ref": "#/components/schemas/Customer" },
                    "request_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/customers/{customer_id}": {
      "parameters": [{ "$ref": "#/components/parameters/CustomerId" }],
      "get": {
        "operationId": "retrieveCustomer",
        "responses": {
          "200": {
            "description": "Customer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "customer": { "$ref": "#/components/schemas/Customer" },
                    "request_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "operationId": "updateCustomer",
        "requestBody": { "$ref": "#/components/requestBodies/Customer" },
        "responses": {
          "200": { "description": "Customer updated" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/products": {
      "get": {
        "operationId": "listProducts",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" },
          { "$ref": "#/components/parameters/Search" },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/ProductStatus" }
          }
        ],
        "responses": {
          "200": { "description": "Product page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProductInput" } }
          }
        },
        "responses": {
          "201": { "description": "Product created" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/products/{product_id}": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "get": {
        "operationId": "retrieveProduct",
        "responses": {
          "200": { "description": "Product" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "operationId": "updateProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "slug": { "type": "string" },
                  "description": { "type": ["string", "null"] },
                  "status": { "const": "active" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Product updated" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/products/{product_id}/archive": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "post": {
        "operationId": "archiveProduct",
        "responses": {
          "200": { "description": "Product archived" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/products/{product_id}/variants": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "post": {
        "operationId": "createVariant",
        "requestBody": { "$ref": "#/components/requestBodies/Variant" },
        "responses": {
          "201": { "description": "Variant created" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/products/{product_id}/variants/{variant_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProductId" },
        { "$ref": "#/components/parameters/VariantId" }
      ],
      "patch": {
        "operationId": "updateVariant",
        "requestBody": { "$ref": "#/components/requestBodies/Variant" },
        "responses": {
          "200": { "description": "Variant updated" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/inventory-levels": {
      "get": {
        "operationId": "listInventoryLevels",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" },
          { "$ref": "#/components/parameters/Search" },
          {
            "name": "location_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "variant_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Inventory level page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/inventory-adjustments": {
      "post": {
        "operationId": "adjustInventory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InventoryAdjustmentInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Append-only inventory adjustment recorded" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" },
          { "$ref": "#/components/parameters/Search" },
          {
            "name": "location_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "financial_status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/FinancialStatus" }
          },
          {
            "name": "fulfilment_status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/FulfilmentStatus" }
          }
        ],
        "responses": {
          "200": { "description": "Order page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createOrder",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OrderInput" } }
          }
        },
        "responses": {
          "201": { "description": "Unpaid order created or replayed" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/orders/{order_id}": {
      "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
      "get": {
        "operationId": "retrieveOrder",
        "responses": {
          "200": { "description": "Order with immutable items" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/orders/{order_id}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
      "post": {
        "operationId": "cancelOrder",
        "responses": {
          "200": { "description": "Unpaid order cancelled" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payments": {
      "get": {
        "operationId": "listPayments",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": { "description": "Environment-scoped payment page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createPayment",
        "description": "Creates and executes a full-order payment. Amount, currency, and customer are derived from the order. Same idempotency key and body replays; changed input returns 409.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentInput" },
              "example": {
                "order_id": "0198f000-0000-7000-8000-000000001600",
                "confirmation": { "mock_scenario": "success" }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Payment executed or safely replayed" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payments/{payment_id}": {
      "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
      "get": {
        "operationId": "retrievePayment",
        "responses": {
          "200": { "description": "Payment with attempts, transactions, and refunds" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/refunds": {
      "get": {
        "operationId": "listRefunds",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": { "description": "Environment-scoped refund page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createRefund",
        "description": "Creates an idempotent full or partial refund. Omitting amount refunds the remaining refundable amount.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefundInput" } }
          }
        },
        "responses": {
          "201": { "description": "Refund executed or safely replayed" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/refunds/{refund_id}": {
      "parameters": [{ "$ref": "#/components/parameters/RefundId" }],
      "get": {
        "operationId": "retrieveRefund",
        "responses": {
          "200": { "description": "Refund" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/transactions": {
      "get": {
        "operationId": "listTransactions",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": { "description": "Append-only transaction evidence page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/transactions/{transaction_id}": {
      "parameters": [{ "$ref": "#/components/parameters/TransactionId" }],
      "get": {
        "operationId": "retrieveTransaction",
        "responses": {
          "200": { "description": "Immutable transaction evidence" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/provider-accounts": {
      "get": {
        "operationId": "listProviderAccounts",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }],
        "responses": {
          "200": { "description": "Provider accounts with declared capabilities; no credentials" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/sessions": {
      "get": {
        "operationId": "listCheckoutSessions",
        "description": "Lists environment-scoped Checkout Sessions. Requires checkout:read.",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": { "description": "Checkout Session page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createCheckoutSession",
        "description": "Creates an expiring server-priced Checkout Session. Requires checkout:write.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckoutSessionInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Checkout Session and one-time hosted URL" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/sessions/{checkout_session_id}": {
      "parameters": [
        {
          "name": "checkout_session_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "operationId": "retrieveCheckoutSession",
        "responses": {
          "200": { "description": "Checkout Session with immutable quote" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/sessions/{checkout_session_id}/confirm": {
      "parameters": [
        {
          "name": "checkout_session_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        { "$ref": "#/components/parameters/IdempotencyKey" }
      ],
      "post": {
        "operationId": "confirmCheckoutSession",
        "description": "Creates/replays the canonical Customer, Order, and Payment and returns success, failure, or pending state.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Resolved Checkout Session" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/checkout/sessions/{checkout_session_id}/cancel": {
      "parameters": [
        {
          "name": "checkout_session_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "operationId": "cancelCheckoutSession",
        "responses": {
          "200": { "description": "Cancelled open Checkout Session" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payment-links": {
      "get": {
        "operationId": "listPaymentLinks",
        "description": "Requires payment_links:read.",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": { "description": "Payment Link page" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createPaymentLink",
        "description": "Creates a product, fixed, or flexible reusable link. Requires payment_links:write.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PaymentLinkInput" } }
          }
        },
        "responses": {
          "201": { "description": "Payment Link and one-time public URL" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payment-links/{payment_link_id}": {
      "parameters": [
        {
          "name": "payment_link_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "operationId": "retrievePaymentLink",
        "responses": {
          "200": { "description": "Payment Link" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "operationId": "updatePaymentLink",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Updated Payment Link" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payment-links/{payment_link_id}/activate": {
      "parameters": [
        {
          "name": "payment_link_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "operationId": "activatePaymentLink",
        "responses": {
          "200": { "description": "Activated Payment Link" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/payment-links/{payment_link_id}/deactivate": {
      "parameters": [
        {
          "name": "payment_link_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "operationId": "deactivatePaymentLink",
        "responses": {
          "200": { "description": "Deactivated Payment Link" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/public/checkout/{token}": {
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 43, "maxLength": 43 }
        }
      ],
      "get": {
        "operationId": "retrievePublicCheckout",
        "security": [],
        "responses": {
          "200": { "description": "Sanitized hosted Checkout Session" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "confirmPublicCheckout",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Resolved hosted Checkout Session" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/public/payment-links/{token}": {
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 43, "maxLength": 43 }
        }
      ],
      "get": {
        "operationId": "retrievePublicPaymentLink",
        "security": [],
        "responses": {
          "200": { "description": "Sanitized public Payment Link" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "openPublicPaymentLink",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["idempotency_key"],
                "properties": {
                  "amount": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
                  "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 255 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Fresh Checkout Session" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/store": {
      "get": {
        "operationId": "retrieveStore",
        "responses": {
          "200": { "description": "Merchant Store configuration" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "operationId": "updateStore",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "type": "object", "additionalProperties": false } }
          }
        },
        "responses": {
          "200": { "description": "Updated Store" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/store/activate": {
      "post": {
        "operationId": "activateStore",
        "responses": {
          "200": { "description": "Active Store" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/store/pause": {
      "post": {
        "operationId": "pauseStore",
        "responses": {
          "200": { "description": "Paused Store" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/store/products/{product_id}/publish": {
      "parameters": [
        {
          "name": "product_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "operationId": "publishStoreProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "type": "object", "additionalProperties": false } }
          }
        },
        "responses": {
          "201": { "description": "Published Store listing" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/store/products/{product_id}/unpublish": {
      "parameters": [
        {
          "name": "product_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "operationId": "unpublishStoreProduct",
        "responses": {
          "200": { "description": "Unpublished Store listing" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/public/stores/{slug}": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      ],
      "get": {
        "operationId": "retrievePublicStore",
        "security": [],
        "responses": {
          "200": { "description": "Safe active Store projection" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/public/stores/{slug}/products": {
      "parameters": [
        { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "listPublicStoreProducts",
        "security": [],
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/After" }
        ],
        "responses": {
          "200": { "description": "Published Product projections with availability" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/public/stores/{slug}/products/{product_slug}": {
      "parameters": [
        { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "product_slug", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "retrievePublicStoreProduct",
        "security": [],
        "responses": {
          "200": { "description": "Published Product detail projection" },
          "default": { "$ref": "#/components/responses/Error" }
