{
  "name": "yinne",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "vitest run",
    "db:generate": "pnpm --filter @yinne/database db:generate",
    "db:migrate": "pnpm --filter @yinne/database db:migrate",
    "db:seed": "pnpm --filter @yinne/database db:seed",
    "db:check": "pnpm --filter @yinne/database db:check",
    "worker:migrate": "pnpm --filter @yinne/worker db:migrate",
    "openapi:validate": "node tooling/scripts/validate-openapi.mjs",
    "verify:clean-db": "pnpm --filter @yinne/database verify:clean-db"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "dotenv": "16.6.1",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
